# Copy to infra/env/.env and adjust. Values are the host-side defaults from
# docs/architecture/runtime-conventions.md; docker-compose.yml overrides hostnames
# (kafka:29092, mlflow:5000, minio:9000, postgres:5432) for containers.

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345

MODEL_NAME=fraud-xgb
FRAUD_THRESHOLD=0.5
ALERT_THRESHOLD=0.5

POSTGRES_USER=infinity
POSTGRES_PASSWORD=infinity
DATABASE_URL=postgresql://infinity:infinity@localhost:5432/agent
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/infinity
SPRING_DATASOURCE_USERNAME=infinity
SPRING_DATASOURCE_PASSWORD=infinity
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# none (rules only), ollama, anthropic or openai
LLM_PROVIDER=none

# Host ports published by docker-compose. Change them when a port is already
# taken on your machine (5000 is used by AirPlay on recent macOS).
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MLFLOW_HOST_PORT=5000
BACKEND_HOST_PORT=8080
INFERENCE_HOST_PORT=8000
AGENT_HOST_PORT=8100
FRONTEND_HOST_PORT=3000
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001

# Grafana admin account (anonymous visitors get read-only access)
GRAFANA_ADMIN_PASSWORD=admin
