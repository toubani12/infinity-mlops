#!/usr/bin/env sh
msg_file="$1"
header=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n1)

case "$header" in
  Merge\ *|Revert\ *|fixup!*|squash!*) exit 0 ;;
esac

types='feat|fix|perf|refactor|test|docs|build|ci|chore|revert'
if ! printf '%s\n' "$header" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: [a-z0-9].{0,71}$"; then
  echo "commit-msg: header must match <type>(<scope>): <summary>, max 72 chars after the colon" >&2
  echo "  got: $header" >&2
  exit 1
fi

if grep -v '^#' "$msg_file" | grep -Eiq 'co-authored-by:.*(claude|anthropic|copilot|openai|gpt|gemini|cursor|noreply@)|generated (with|by)|🤖'; then
  echo "commit-msg: remove tool attribution lines before committing" >&2
  exit 1
fi
