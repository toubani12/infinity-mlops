{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinity-mlops.io/contracts/events/drift.detected.v1.json",
  "title": "drift.detected.v1",
  "description": "Drift report crossing a threshold, published by drift-monitor. Key: report_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "detected_at",
    "window",
    "drift_share",
    "drifted_features",
    "metrics"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "format": "uuid"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "rows"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "drift_share": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "drifted_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "out_of_range_share": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pr_auc": {
          "type": [
            "number",
            "null"
          ]
        },
        "reference_pr_auc": {
          "type": [
            "number",
            "null"
          ]
        },
        "recall_at_p90": {
          "type": [
            "number",
            "null"
          ]
        },
        "labeled_rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "model_version": {
      "type": "string"
    },
    "report_uri": {
      "type": "string"
    }
  }
}
